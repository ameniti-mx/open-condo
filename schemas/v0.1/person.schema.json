{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://open-condo.org/schemas/v0.1/person.schema.json",
  "title":"Open Condo Person v0.1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","id","name","status","created_at","updated_at"],
  "properties":{
    "schema_version":{"$ref":"common.schema.json#/$defs/schemaVersion"},
    "id":{"$ref":"common.schema.json#/$defs/identifier"},
    "external_ids":{"$ref":"common.schema.json#/$defs/externalIds"},
    "name":{"type":"object","additionalProperties":false,"required":["display_name"],"properties":{"given_names":{"type":"string","maxLength":150},"family_name":{"type":"string","maxLength":150},"display_name":{"type":"string","minLength":1,"maxLength":300}}},
    "contact":{"type":"object","additionalProperties":false,"properties":{"email":{"type":"string","format":"email","maxLength":254},"phone":{"type":"object","additionalProperties":false,"required":["country_code","national_number"],"properties":{"country_code":{"type":"string","pattern":"^[0-9]{1,3}$"},"national_number":{"type":"string","pattern":"^[0-9]{7,15}$"}}}}},
    "status":{"type":"string","enum":["active","inactive","archived"]},
    "metadata":{"$ref":"common.schema.json#/$defs/metadata"},
    "created_at":{"$ref":"common.schema.json#/$defs/dateTime"},
    "updated_at":{"$ref":"common.schema.json#/$defs/dateTime"}
  }
}
