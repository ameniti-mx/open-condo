{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-condo.org/schemas/v0.1/condominium.schema.json",
  "title": "Open Condo Condominium v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "status", "country", "timezone", "currency", "address", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "external_ids": {"$ref": "common.schema.json#/$defs/externalIds"},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "legal_name": {"type": "string", "maxLength": 250},
    "status": {"type": "string", "enum": ["active", "inactive", "archived"]},
    "country": {"type": "string", "const": "MX"},
    "timezone": {"type": "string", "minLength": 1, "examples": ["America/Mexico_City", "America/Monterrey"]},
    "currency": {"$ref": "common.schema.json#/$defs/currency"},
    "address": {"$ref": "common.schema.json#/$defs/address"},
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "declared_unit_count": {"type": "integer", "minimum": 0},
        "uses_indiviso": {"type": "boolean"}
      }
    },
    "metadata": {"$ref": "common.schema.json#/$defs/metadata"},
    "created_at": {"$ref": "common.schema.json#/$defs/dateTime"},
    "updated_at": {"$ref": "common.schema.json#/$defs/dateTime"}
  }
}
