{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://open-condo.org/schemas/v0.2/rule-set.schema.json",
  "title":"Open Condo Rule Set v0.2",
  "type":"object","additionalProperties":false,
  "required":["schema_version","id","condominium_id","name","scope","status","conflict_strategy","rules","created_at","updated_at"],
  "properties":{
    "schema_version":{"$ref":"common.schema.json#/$defs/schemaVersion"},
    "id":{"$ref":"common.schema.json#/$defs/identifier"},
    "condominium_id":{"$ref":"common.schema.json#/$defs/identifier"},
    "name":{"type":"string","minLength":1,"maxLength":180},
    "description":{"type":"string","maxLength":3000},
    "scope":{"enum":["amenity_usage","reservation_creation","reservation_modification","reservation_cancellation","check_in","no_show","pricing","availability"]},
    "status":{"enum":["draft","active","inactive","retired"]},
    "effective_from":{"$ref":"common.schema.json#/$defs/dateTime"},
    "effective_until":{"oneOf":[{"$ref":"common.schema.json#/$defs/dateTime"},{"type":"null"}]},
    "conflict_strategy":{"enum":["deny_overrides","highest_priority","first_match","collect_all"]},
    "rules":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","name","priority","when","effects"],"properties":{"id":{"$ref":"common.schema.json#/$defs/identifier"},"name":{"type":"string","minLength":1,"maxLength":180},"description":{"type":"string","maxLength":2000},"enabled":{"type":"boolean","default":true},"priority":{"type":"integer","minimum":-100000,"maximum":100000},"stop_processing":{"type":"boolean","default":false},"when":{"$ref":"common.schema.json#/$defs/condition"},"effects":{"type":"array","minItems":1,"items":{"$ref":"common.schema.json#/$defs/effect"}},"tags":{"type":"array","uniqueItems":true,"items":{"type":"string","maxLength":80}}}}},
    "metadata":{"$ref":"common.schema.json#/$defs/metadata"},
    "created_at":{"$ref":"common.schema.json#/$defs/dateTime"},
    "updated_at":{"$ref":"common.schema.json#/$defs/dateTime"}
  }
}