{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-condo.org/schemas/v0.2/common.schema.json",
  "title": "Open Condo Common Definitions v0.2",
  "$defs": {
    "schemaVersion": {"type":"string","const":"0.2.0"},
    "identifier": {"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "date": {"type":"string","format":"date"},
    "dateTime": {"type":"string","format":"date-time"},
    "time": {"type":"string","pattern":"^(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d)?$"},
    "currency": {"type":"string","pattern":"^[A-Z]{3}$"},
    "money": {"type":"object","additionalProperties":false,"required":["value","currency"],"properties":{"value":{"type":"number","multipleOf":0.01},"currency":{"$ref":"#/$defs/currency"}}},
    "metadata": {"type":"object","additionalProperties":true,"default":{}},
    "auditFields": {"type":"object","required":["created_at","updated_at"],"properties":{"created_at":{"$ref":"#/$defs/dateTime"},"updated_at":{"$ref":"#/$defs/dateTime"}}},
    "operand": {
      "oneOf": [
        {"type":"object","additionalProperties":false,"required":["path"],"properties":{"path":{"type":"string","pattern":"^\\$\\.[A-Za-z0-9_.-]+$"}}},
        {"type":"object","additionalProperties":false,"required":["value"],"properties":{"value":{}}},
        {"type":"object","additionalProperties":false,"required":["function"],"properties":{"function":{"enum":["now","today","day_of_week","minutes_between","days_between","count","sum"]},"arguments":{"type":"array","items":{"$ref":"#/$defs/operand"},"default":[]}}}
      ]
    },
    "condition": {
      "oneOf": [
        {"type":"object","additionalProperties":false,"required":["all"],"properties":{"all":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/condition"}}}},
        {"type":"object","additionalProperties":false,"required":["any"],"properties":{"any":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/condition"}}}},
        {"type":"object","additionalProperties":false,"required":["not"],"properties":{"not":{"$ref":"#/$defs/condition"}}},
        {"type":"object","additionalProperties":false,"required":["left","operator","right"],"properties":{"left":{"$ref":"#/$defs/operand"},"operator":{"enum":["eq","neq","gt","gte","lt","lte","in","not_in","contains","starts_with","ends_with","matches","exists","overlaps"]},"right":{"$ref":"#/$defs/operand"}}}
      ]
    },
    "effect": {
      "type":"object","additionalProperties":false,"required":["type"],
      "properties":{
        "type":{"enum":["allow","deny","require_approval","set_price","add_fee","set_deposit","set_capacity","set_duration","set_booking_window","set_cancellation_policy","set_penalty","set_priority","set_visibility","require_document","require_acknowledgement","emit_warning","assign_resource"]},
        "code":{"type":"string","maxLength":100},
        "message":{"type":"string","maxLength":500},
        "parameters":{"type":"object","additionalProperties":true,"default":{}}
      }
    }
  }
}